#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ "${1:-}" == --software-rendering ]]; then
  export NIIMSTUDIO_RENDERER=software
  shift
fi
case "${1:-}" in
  --version|--update|--uninstall)
    operation="${1#--}"; shift
    for interpreter in /usr/bin/python3 /usr/bin/python; do
      if [[ -x "$interpreter" ]]; then
        exec "$interpreter" "$root/scripts/managed_install.py" "$operation" "$@"
      fi
    done
    echo "System Python 3 is required." >&2
    exit 1 ;;
esac
export PYTHONPATH="$root/native${PYTHONPATH:+:$PYTHONPATH}"
if [[ ! -f "$root/dist/index.html" ]]; then
  echo "Editor is not built. In $root, run npm ci && npm run build" >&2
  exit 1
fi
for python in "${NIIMSTUDIO_PYTHON:-/usr/bin/python3}" /usr/bin/python; do
  if [[ -x "$python" ]]; then
    exec "$python" "$root/scripts/launch.py" "$@"
  fi
  [[ -z "${NIIMSTUDIO_PYTHON:-}" ]] || break
done
echo "NiimStudio needs system Python 3.11+ with PyGObject." >&2
exit 1
